# Use the EXACT display name on your LinkedIn profile. Do not put a password here.
SELF_NAME=REPLACE_WITH_YOUR_LINKEDIN_DISPLAY_NAME
# Optional: helps identify your own messages when a profile link is available.
SELF_PROFILE_URL=

# First run is read-only: no invitations accepted and no messages sent.
# Reading a conversation can still mark it read on LinkedIn.
DRY_RUN=true

# Leave auto to use OpenAI when a key exists, otherwise use basic local rules.
# Rules are a fallback, not a substitute for good multilingual replies.
REPLY_ENGINE=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional facts the assistant may state. Do not include secrets.
OWNER_CONTEXT=

# Optional exact names, separated by semicolons. Empty means any incoming person.
# Restrict to your tester when you know their exact LinkedIn display name.
ALLOWED_NAMES=
ACCEPT_CONNECTIONS=true

POLL_MS=5000
INVITES_POLL_MS=30000
REFRESH_MS=120000
SETTLE_MS=2500
MAX_VISIBLE_THREADS=20
MAX_REPLIES_PER_HOUR=120
MAX_ACCEPTS_PER_HOUR=20
MAX_REPLY_CHARS=500
HEADLESS=false
